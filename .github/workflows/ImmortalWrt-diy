# 工作流名称
name:编译 ImmortalWrt 固件
固件
# 工作流触发条件
on:
  workflow_dispatch:
    inputs:
      immortalwrt_version:
        description: '选择要编译的 ImmortalWrt 版本'
        required: true
        default: 'openwrt-24.10'
        type: choice
        options:
          - master   # 最新的开发版
          - openwrt-24.10 # 当前最新的测试版
          - openwrt-23.05 # 上一个稳定版
          - openwrt-21.02 # 更早的稳定版
      ssh:
        description: '在编译前进入 SSH 调试 (true/false)'
        required: false
        default: 'false'

# 环境变量，所有作业共享
env:
  # REPO_URL 和 REPO_BRANCH 现在是动态的
  REPO_URL: https://github.com/immortalwrt/immortalwrt.git
  REPO_BRANCH: ${{ github.event.inputs.immortalwrt_version }} # <-- 核心改动点
  
  CONFIG_FILE: config/immortalwrt/ea0326/mini.config
  DIY_P1_SH: config/immortalwrt/ea0326/DIY-1.sh
  DIY_P2_SH: config/immortalwrt/ea0326/DIY-2.sh
  UPLOAD_RELEASE: 'true'
  TZ: Asia/Shanghai

jobs:
  #####################################################################
  # 作业 1: 配置兼容性检查 (快速失败)
  #####################################################################
  check:
    name: 🔬 版本审核 (${{ env.REPO_BRANCH }})
    runs-on: ubuntu-22.04
    outputs:
      device_name: ${{ steps.get_device_name.outputs.device_name }}
      target_subdir: ${{ steps.get_device_name.outputs.target_subdir }}

    steps:
      - name: 检出仓库代码
        uses: actions/checkout@v4

      - name: 检查配置文件是否存在
        run: |
          if [ ! -f "${{ env.CONFIG_FILE }}" ]; then
            echo "::error file=${{ env.CONFIG_FILE }}::配置文件未找到！请检查路径是否正确。"
            exit 1
          fi

      - name: 安装最小化依赖
        run: |
          sudo apt-get update
          sudo apt-get install -y git wget libncurses5-dev
          
      - name: 克隆 ImmortalWrt 源码 (指定分支)
        run: git clone --depth=1 --branch "$REPO_BRANCH" "$REPO_URL" openwrt

      - name: 更新并安装 Feeds
        working-directory: ./openwrt
        run: |
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: 【核心】审核配置文件兼容性
        id: verify_config
        working-directory: ./openwrt
        run: |
          cp "../${{ env.CONFIG_FILE }}" .config
          make defconfig
          DEVICE_LINE=$(grep '^CONFIG_TARGET_.*_DEVICE_.*=y' .config)
          if [ -z "$DEVICE_LINE" ]; then
            echo "::error::配置兼容性审核失败！您的 '${{ env.CONFIG_FILE }}' 与选择的 '${{ env.REPO_BRANCH }}' 分支不兼容。"
            echo "::error::请使用对应分支的源码重新生成配置文件。"
            echo "--- 原始配置与更新后配置的差异 ---"
            diff "../${{ env.CONFIG_FILE }}" .config || true
            exit 1
          fi
          echo "✅ 配置兼容性审核通过。"
          echo "status=success" >> $GITHUB_OUTPUT

      - name: 提取设备名称和路径供后续作业使用
        id: get_device_name
        if: steps.verify_config.outputs.status == 'success'
        run: |
          cd openwrt
          DEVICE_LINE=$(grep '^CONFIG_TARGET_.*_DEVICE_.*=y' .config)
          DEVICE_NAME=$(echo "$DEVICE_LINE" | sed -r 's/.*DEVICE_(.*)=y/\1/')
          TARGET_STR=$(echo "$DEVICE_LINE" | sed -r 's/CONFIG_TARGET_(.*)_DEVICE_.*/\1/')
          TARGET_SUBDIR=$(echo "$TARGET_STR" | tr '_' '/')
          echo "device_name=${DEVICE_NAME}" >> $GITHUB_OUTPUT
          echo "target_subdir=${TARGET_SUBDIR}" >> $GITHUB_OUTPUT


  #####################################################################
  # 作业 2: 编译固件 (仅在检查通过后运行)
  #####################################################################
  build:
    name: 🛠️ 编译固件 (${{ env.REPO_BRANCH }})
    runs-on: ubuntu-22.04
    needs: check
    timeout-minutes: 360

    steps:
      - name: 检出仓库代码
        uses: actions/checkout@v4

      - name: 快速清理磁盘空间
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc
          df -h

      - name: 安装完整编译依赖
        env:
          DEBIAN_FRONTEND: noninteractive
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential ccache ecj fastjar file g++ gawk gettext git java-propose-classpath libelf-dev libncurses5-dev libncursesw5-dev libssl-dev python3-distutils python3-dev python3-pip rsync subversion sudo unzip wget xz-utils zlib1g-dev
          sudo timedatectl set-timezone "$TZ"

      - name: 配置并缓存 ccache (版本隔离)
        uses: actions/cache@v4
        with:
          path: ~/.ccache
          # <-- 关键改动：在 key 中加入分支名
          key: ${{ runner.os }}-ccache-${{ env.REPO_BRANCH }}-${{ hashFiles(env.CONFIG_FILE, env.DIY_P1_SH, env.DIY_P2_SH) }}
          restore-keys: |
            ${{ runner.os }}-ccache-${{ env.REPO_BRANCH }}-
        env:
          CCACHE_DIR: ~/.ccache
        run: |
          mkdir -p ~/.ccache
          echo "max_size = 10.0G" > ~/.ccache/ccache.conf
          ccache -s

      - name: 克隆 ImmortalWrt 源码 (指定分支)
        run: git clone --branch "$REPO_BRANCH" "$REPO_URL" openwrt

      - name: 缓存 OpenWrt dl 目录 (版本隔离)
        uses: actions/cache@v4
        with:
          path: openwrt/dl
          # <-- 关键改动：在 key 中加入分支名
          key: ${{ runner.os }}-immortalwrt-dl-${{ env.REPO_BRANCH }}-${{ hashFiles(env.CONFIG_FILE) }}

      - name: 运行 DIY 脚本 (P1)
        run: |
          if [ -f "$DIY_P1_SH" ]; then
            chmod +x "$DIY_P1_SH"
            cd openwrt
            "$GITHUB_WORKSPACE/$DIY_P1_SH"
          fi

      - name: 更新并安装 Feeds
        run: |
          cd openwrt
          ./scripts/feeds update -a
          ./scripts/feeds install -a
      
      - name: 设置 SSH 调试 (可选)
        if: github.event.inputs.ssh == 'true'
        uses: mxschmitt/action-tmate@v3
        with:
          working-directory: openwrt

      - name: 加载配置并运行 DIY 脚本 (P2)
        run: |
          cp "$CONFIG_FILE" openwrt/.config
          echo "CONFIG_CCACHE=y" >> openwrt/.config
          if [ -f "$DIY_P2_SH" ]; then
            chmod +x "$DIY_P2_SH"
            cd openwrt
            "$GITHUB_WORKSPACE/$DIY_P2_SH"
          fi

      - name: 下载软件包源码并更新 .config
        run: |
          cd openwrt
          make defconfig
          make download -j$(nproc)
          find dl -name "*.badcheck" -delete

      - name: 编译固件
        id: compile
        run: |
          cd openwrt
          make -j$(nproc) || make -j1 V=s
          echo "status=success" >> $GITHUB_OUTPUT

      - name: 打包编译产物
        if: steps.compile.outputs.status == 'success'
        uses: actions/upload-artifact@v4
        with:
          name: immortalwrt-firmware
          path: openwrt/bin/targets/${{ needs.check.outputs.target_subdir }}

  #####################################################################
  # 作业 3: 发布固件 (已更新重命名和版本信息)
  #####################################################################
  publish:
    name: 🚀 发布固件 (${{ env.REPO_BRANCH }})
    runs-on: ubuntu-22.04
    needs: [check, build]
    permissions:
      contents: write

    steps:
      - name: 下载编译好的固件
        uses: actions/download-artifact@v4
        with:
          name: immortalwrt-firmware
          path: ./firmware

      - name: 根据设备名称重命名固件
        env:
          DEVICE_NAME: ${{ needs.check.outputs.device_name }}
        run: |
          cd ./firmware
          BUILD_DATE=$(date -d "${{ github.event.created_at }}" +"%Y%m%d")
          
          find . -type f -name "*sysupgrade*" | while read -r file; do
            ext="${file##*.}"
            mv "$file" "${DEVICE_NAME}_${{ env.REPO_BRANCH }}_${BUILD_DATE}_sysupgrade.$ext"
            echo "重命名: $file -> ${DEVICE_NAME}_${{ env.REPO_BRANCH }}_${BUILD_DATE}_sysupgrade.$ext"
          done
          
          find . -type f -name "*factory*" | while read -r file; do
            ext="${file##*.}"
            mv "$file" "${DEVICE_NAME}_${{ env.REPO_BRANCH }}_${BUILD_DATE}_factory.$ext"
            echo "重命名: $file -> ${DEVICE_NAME}_${{ env.REPO_BRANCH }}_${BUILD_DATE}_factory.$ext"
          done
          
          echo "重命名后文件列表:"
          ls -l

      - name: 准备 Release 说明
        run: |
          FILE_TIME=$(date -d "${{ github.event.created_at }}" +"%Y年%m月%d日")
          BODY=$(cat <<EOF
          **ImmortalWrt for ${DEVICE_NAME} (${REPO_BRANCH})**
          
          - **Branch**: \`${{ env.REPO_BRANCH }}\`
          - **Build Time**: ${FILE_TIME}
          
          **默认信息**
          - **IP 地址**: \`192.168.1.1\`
          - **密码**: \`password\` (首次登录请立即修改)
          
          ---
          
          )
          echo "release_body<<EOF" >> $GITHUB_ENV
          echo "$BODY" >> $GITHUB_ENV
          echo "EOF" >> $GITHUB_ENV

      - name: 创建 GitHub Release
        if: env.UPLOAD_RELEASE == 'true'
        uses: softprops/action-gh-release@v2
        with:
          name: ImmortalWrt ${{ needs.check.outputs.device_name }} (${{ env.REPO_BRANCH }}) - ${{ github.run_number }}
          tag_name: ${{ needs.check.outputs.device_name }}-${{ env.REPO_BRANCH }}-${{ github.run_id }}
          body: ${{ env.release_body }}
          files: ./firmware/*
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          
      - name: 清理旧的 Workflow 运行记录
        uses: Mattraks/delete-workflow-runs@v2
        with:
          retain_days: 2
          keep_minimum_runs: 3

      - name: 删除旧的 Release (保留最近10个)
        if: env.UPLOAD_RELEASE == 'true'
        uses: dev-drprasad/delete-older-releases@v0.3.1
        with:
          keep_latest: 10
          delete_tags: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
