# ======================================================
# 1. 目标平台和设备
# ======================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_hiwifi_hc5761=y
CONFIG_TARGET_PROFILE="DEVICE_hiwifi_hc5761"

# ======================================================
# 2. 核心系统 (必须)
# (firewall4 会自动拉入 kmod-nft-* 内核模块)
# ======================================================
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ======================================================
# 3. LuCI 界面
# ======================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_LUCI_LANG_zh_Hans=y

# ======================================================
# 4. 彻底禁用 Wi-Fi (关键！)
# 以下选项必须被禁用。
# "is not set" 会在 `make defconfig` 时强制禁用它们。
# ======================================================

# --- 禁用驱动 ---
# CONFIG_PACKAGE_kmod-mt76 is not set
# CONFIG_PACKAGE_kmod-mt76x0e is not set
# CONFIG_PACKAGE_kmod-rt2800-soc is not set

# --- 禁用应用程序 ---
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set

# --- 禁用库和依赖项 ---
# CONFIG_PACKAGE_iwinfo is not set
# CONFIG_PACKAGE_rpcd-mod-iwinfo is not set
# CONFIG_PACKAGE_wireless-regdb is not set

# ======================================================
# 5. 确保不编译旧的 iptables (冲突)
# (由 firewall4 自动处理)
# ======================================================
# CONFIG_PACKAGE_kmod-ipt-core is not set
# CONFIG_PACKAGE_kmod-nf-ipt is not set
# CONFIG_PACKAGE_kmod-ipt-offload is not set
