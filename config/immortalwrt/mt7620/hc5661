# ======================================================
# 1. 目标平台和设备 (HiWiFi HC5661 / 极1S)
# ======================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_hiwifi_hc5661=y
CONFIG_TARGET_PROFILE="DEVICE_hiwifi_hc5661"

# ======================================================
# 2. 基础系统和 LuCI
# (firewall4 会自动拉入 kmod-nft-* 内核模块)
# ======================================================

# 基础系统 (必须)
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# LuCI 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_LUCI_LANG_zh_Hans=y

# ======================================================
# 3. 彻底禁用 Wi-Fi (关键！)
# HC5661 只有 2.4G 驱动 (rt2800-soc)
# ======================================================

# --- 禁用驱动 (2.4G) ---
# CONFIG_PACKAGE_kmod-rt2800-soc is not set
# CONFIG_PACKAGE_kmod-mt76 is not set

# --- 禁用应用程序 (Wi-Fi 服务) ---
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set

# --- 禁用库和依赖项 (防止 LuCI 拉回) ---
# CONFIG_PACKAGE_iwinfo is not set
# CONFIG_PACKAGE_rpcd-mod-iwinfo is not set
# CONFIG_PACKAGE_wireless-regdb is not set

# ======================================================
# 4. 移除冲突的 iptables 模块
# (firewall4 使用 nftables, 不需要这些)
# ======================================================
# CONFIG_PACKAGE_kmod-ipt-core is not set
# CONFIG_PACKAGE_kmod-nf-ipt is not set
# CONFIG_PACKAGE_kmod-ipt-offload is not set

# ======================================================
# 5. 您可以继续在这里添加其他您需要的软件包
# ======================================================
# 例如: CONFIG_PACKAGE_luci-app-ddns=y
# CONFIG_PACKAGE_luci-app-samba4=y
