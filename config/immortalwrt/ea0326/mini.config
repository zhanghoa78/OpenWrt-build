# =================================================================
# 核心目标平台定义 (MANDATORY FOR BUILD SCRIPT)
# 这是为了满足自动化脚本的预检查要求，请务必保留
# =================================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_nokia_ea0326gmp=y

# =================================================================
# LuCI Web 界面 (及中文支持)
# =================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-theme-bootstrap-mod=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-app-eqos-mtk=y
CONFIG_PACKAGE_luci-app-mtk=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
CONFIG_PACKAGE_luci-i18n-eqos-mtk-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mtk-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# =================================================================
# 核心网络服务与工具
# =================================================================
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_zram-swap=y

# =================================================================
# 内核模块
# (大部分驱动由设备profile自动选择，这里只放额外添加的)
# =================================================================
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y

# =================================================================
# 底层工具与库
# (大部分库为依赖项，会被自动选择，这里只放明确需要的基础包)
# =================================================================
CONFIG_PACKAGE_ethtool=y
CONFIG_TARGET_MEDIATEK_FILOGIC_DEVICE_nokia_ea0326_rsv=y
CONFIG_TARGET_MEDIATEK_FILOGIC_DEVICE_nokia_ea0326_rsv_factory=y
